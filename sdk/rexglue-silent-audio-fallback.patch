+// No usable playback device (none connected, or the audio service is down):
+// keep the title running without sound. The guest's audio thread is paced by
+// the client semaphore, so a timer thread drains the queue at the real frame
+// rate (256 samples at 48 kHz) and releases the semaphore exactly as the
+// device callback would.
+bool SDLAudioDriver::StartSilent() {
+  REXAPU_WARN("No audio playback device - running without sound");
+  silent_run_.store(true);
+  silent_thread_ = std::thread([this] {
+    const auto period = std::chrono::nanoseconds(1000000000ll * channel_samples_ / frame_frequency_);
+    auto next = std::chrono::steady_clock::now();
+    while (silent_run_.load(std::memory_order_relaxed)) {
+      next += period;
+      std::this_thread::sleep_until(next);
+      bool consumed = false;
+      {
+        std::unique_lock<std::mutex> guard(frames_mutex_);
+        if (!frames_queued_.empty()) {
+          frames_unused_.push(frames_queued_.front());
+          frames_queued_.pop();
+          consumed = true;
+        }
+      }
+      if (consumed) {
+        semaphore_->Release(1, nullptr);
+      }
+      // Don't try to catch up after a long stall.
+      const auto now = std::chrono::steady_clock::now();
+      if (now - next > std::chrono::milliseconds(100)) next = now;
+    }
+  });
+  return true;
+}
